
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ＺＯＮＥＸ　×　ＦＩＲＥＢＡＳＥ</title>
    <style>
        :root { 
            --bg: #070b14; --card-bg: #0f1523; --border: #1d293d;
            --text-main: #ffffff; --text-muted: #8b9eb7;
            --accent-green: #00ff88; --accent-red: #ff4466;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); color: var(--text-main); padding: 20px; min-height: 100vh; }
        .container { max-width: 1200px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        .header h1 { font-size: 24px; display: flex; align-items: center; gap: 10px; }
        .header h1 span { color: var(--accent-green); text-shadow: 0 0 10px rgba(0,255,136,0.3); }
        .header-btns button { background: transparent; border: 1px solid var(--border); color: white; padding: 8px 15px; border-radius: 8px; cursor: pointer; font-size: 14px; margin-left: 10px; }
        .header-btns button:hover { background: var(--border); }
        .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 25px; }
        .stat-card { background: var(--card-bg); border: 1px solid var(--border); padding: 15px 20px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; }
        .stat-card .info h3 { font-size: 12px; color: var(--text-muted); margin-bottom: 5px; }
        .stat-card .info p { font-size: 22px; font-weight: 700; }
        .stat-card .icon { color: var(--accent-green); font-size: 24px; }
        .controls { display: flex; gap: 15px; margin-bottom: 20px; }
        .search-box { flex: 1; background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 15px; display: flex; align-items: center; gap: 10px; }
        .search-box input { background: transparent; border: none; color: white; width: 100%; outline: none; }
        .dropdown { background: var(--card-bg); border: 1px solid var(--border); color: white; padding: 10px 15px; border-radius: 8px; outline: none; width: 200px; }
        .table-container { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { padding: 15px; font-size: 11px; color: var(--text-muted); text-transform: uppercase; border-bottom: 1px solid var(--border); }
        td { padding: 15px; font-size: 13px; border-bottom: 1px solid var(--border); }
        .url-col { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #c9d1d9; }
        .api-key-col { color: var(--text-muted); font-family: monospace; }
        .online { color: var(--accent-green); font-weight: 600; }
        .offline { color: var(--accent-red); font-weight: 600; }
        .total { color: white; font-weight: 600; }
        .time-col { font-size: 11px; color: var(--text-muted); }
        .status-badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .status-active { background: rgba(0, 255, 136, 0.1); color: var(--accent-green); border: 1px solid rgba(0, 255, 136, 0.2); }
        .status-inactive { background: rgba(255, 68, 102, 0.1); color: var(--accent-red); border: 1px solid rgba(255, 68, 102, 0.2); }
        .loading-td { text-align: center; padding: 30px; color: var(--accent-green); }
        @media (max-width: 900px) { .stats-row { grid-template-columns: 1fr 1fr; } .controls { flex-direction: column; } .dropdown { width: 100%; } .table-container { overflow-x: auto; } table { min-width: 800px; } }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔥 <span>ＺＯＮＥＸ　×　ＦＩＲＥＢＡＳＥ</span></h1>
            <div class="header-btns">
                <button onclick="window.location.reload()">🔄 Refresh</button>
                <button>🔒 Lock</button>
            </div>
        </div>
        <div class="stats-row">
            <div class="stat-card"><div class="info"><h3>Total URLs</h3><p id="total-urls">0</p></div><div class="icon">🔗</div></div>
            <div class="stat-card"><div class="info"><h3>Online URLs</h3><p id="total-online" style="color: var(--accent-green);">0</p></div><div class="icon">🟢</div></div>
            <div class="stat-card"><div class="info"><h3>Offline URLs</h3><p id="total-offline" style="color: var(--accent-red);">0</p></div><div class="icon">🔴</div></div>
            <div class="stat-card"><div class="info"><h3>Total Devices</h3><p id="total-devices">0</p></div><div class="icon">👥</div></div>
        </div>
        <div class="controls">
            <div class="search-box"><span>🔍</span><input type="text" id="searchInput" placeholder="Search Firebase URL..."></div>
            <select class="dropdown" id="statusFilter"><option value="all">All Status</option><option value="ONLINE">Online</option><option value="OFFLINE">Offline</option></select>
        </div>
        <div class="table-container">
            <table>
                <thead><tr><th>#</th><th>FIREBASE URL</th><th>API KEY</th><th>🟢 ONLINE</th><th>🔴 OFFLINE</th><th>TOTAL DEVICES</th><th>LAST CHECKED</th><th>STATUS</th></tr></thead>
                <tbody id="tableBody"><tr><td colspan="8" class="loading-td">⏳ Loading Data...</td></tr></tbody>
            </table>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const urlParams = new URLSearchParams(window.location.search);
            const encodedUrl = urlParams.get('s');
            const tbody = document.getElementById('tableBody');
            const searchInput = document.getElementById('searchInput');
            const statusFilter = document.getElementById('statusFilter');

            if (encodedUrl) {
                const firebaseUrl = atob(encodedUrl);
                searchInput.value = firebaseUrl;
                tbody.innerHTML = `<tr><td colspan="8" class="loading-td">⏳ Fetching Live Data from Firebase...</td></tr>`;
                fetch(firebaseUrl + '/.json').then(res => { if(res.status === 200) return res.json(); throw new Error("Offline"); }).then(data => {
                    let total = data ? Object.keys(data).length : 0; let online = Math.floor(total / 2); let offline = total - online;
                    document.getElementById('total-urls').innerText = "1"; document.getElementById('total-online').innerText = "1";
                    document.getElementById('total-offline').innerText = "0"; document.getElementById('total-devices').innerText = total;
                    tbody.innerHTML = `<tr><td>1</td><td class="url-col" title="${firebaseUrl}">${firebaseUrl}</td><td class="api-key-col">••••••••</td><td class="online">${online}</td><td class="offline">${offline}</td><td class="total">${total}</td><td class="time-col">${new Date().toLocaleDateString()}<br>${new Date().toLocaleTimeString()}</td><td><span class="status-badge status-active">🟢 Active</span></td></tr>`;
                }).catch(err => { tbody.innerHTML = `<tr><td colspan="8" class="loading-td" style="color: var(--accent-red);">❌ Database is Offline or Protected.</td></tr>`; });
            } else {
                const demoData = [
                    { url: "https://zonx-app1.firebaseio.com", online: 10, offline: 25, total: 35, status: "ONLINE" },
                    { url: "https://zonx-app2.firebaseio.com", online: 24, offline: 62, total: 86, status: "ONLINE" },
                    { url: "https://zonx-app3.firebaseio.com", online: 11, offline: 49, total: 60, status: "ONLINE" },
                    { url: "https://zonx-app4.firebaseio.com", online: 0, offline: 0, total: 0, status: "OFFLINE" }
                ];
                document.getElementById('total-urls').innerText = demoData.length;
                document.getElementById('total-online').innerText = demoData.filter(d => d.status === 'ONLINE').length;
                document.getElementById('total-offline').innerText = demoData.filter(d => d.status === 'OFFLINE').length;
                document.getElementById('total-devices').innerText = demoData.reduce((sum, d) => sum + d.total, 0);
                function renderTable(data) {
                    tbody.innerHTML = "";
                    data.forEach((row, index) => {
                        const statusClass = row.status === 'ONLINE' ? 'status-active' : 'status-inactive';
                        tbody.innerHTML += `<tr><td>${index + 1}</td><td class="url-col" title="${row.url}">${row.url}</td><td class="api-key-col">••••••••</td><td class="online">${row.online}</td><td class="offline">${row.offline}</td><td class="total">${row.total}</td><td class="time-col">${new Date().toLocaleDateString()}<br>${new Date().toLocaleTimeString()}</td><td><span class="status-badge ${statusClass}">🟢 Active</span></td></tr>`;
                    });
                }
                renderTable(demoData);
                searchInput.addEventListener('input', () => { const q = searchInput.value.toLowerCase(); const s = statusFilter.value; renderTable(demoData.filter(r => r.url.toLowerCase().includes(q) && (s === 'all' || r.status === s))); });
                statusFilter.addEventListener('change', () => { searchInput.dispatchEvent(new Event('input')); });
            }
        });
    </script>
</body>
</html>